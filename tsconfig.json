{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM"],
		"types": ["node"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	},
	"include": ["scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
